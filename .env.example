# The environment variables ras2xugrid reads. Nothing loads this file: set a variable in the
# shell for the command that needs it.
#   bash/zsh:    HECRAS_TEST_DATA=/path/to/folder pixi run test-local
#   PowerShell:  $env:HECRAS_TEST_DATA = "C:\path\to\folder"; pixi run test-local
#
# Folder holding HEC-RAS plan files (*.p??.hdf) for the real-file tests, which are marked
# `local_data` and skipped unless this is set. Plan files are never committed.
HECRAS_TEST_DATA=
